APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATA_DIR=./data
RAW_DIR=./data/raw
SQLITE_PATH=./data/app.db
FAISS_INDEX_PATH=./data/indexes/faiss.index
FAISS_MAP_PATH=./data/indexes/chunk_ids.json

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

VECTOR_TOP_K=10
CONTEXT_MAX_CHUNKS=5
RETRIEVAL_THRESHOLD=0.2

CHUNK_SIZE_TOKENS=550
CHUNK_OVERLAP_TOKENS=80

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# "latest" aliases auto-track Google's current recommended model, so this
# shouldn't need updating even as specific dated models get retired.
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.1

LOG_USER_CONTENT=false
